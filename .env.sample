# ===================== 日志配置 =====================
# 日志级别: DEBUG | INFO | WARNING | ERROR

# 控制台是否输出
LOG_CONSOLE_ENABLE=True

# 控制台日志级别
LOG_CONSOLE_LEVEL=INFO

# 是否输出日志文件
LOG_FILE_ENABLE=True

# 日志文件输出级别
LOG_FILE_LEVEL=DEBUG

# 日志文件保留天数, 自动删除过期日志
LOG_FILE_RETENTION="7 days"

# 日志保存目录, 默认为 <project_dir>/logs
# LOG_FILE_DIR=""

# ===================== MinerU 配置 =====================
# 官方 API 接入: https://mineru.net/apiManage/docs

# MinerU API 地址
MINERU_BASE_URL="https://mineru.net/api/v4"

# MinerU API 密钥
MINERU_API_KEY="sk-41**************************Tuh"