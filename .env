# ===================== 日志配置 =====================
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_CONSOLE_ENABLE=True                 # 控制台是否输出
LOG_CONSOLE_LEVEL=INFO                  # 控制台日志级别
LOG_FILE_ENABLE=True                    # 是否输出日志文件
LOG_FILE_LEVEL=DEBUG                    # 日志文件输出级别
LOG_FILE_RETENTION="7 days"             # 日志文件保留天数, 自动删除过期日志
# LOG_DIR=""                            # 日志保存目录, 默认为 <project_dir>/logs
LOG_NAME="log_{time:YYYY-MM-DD}.log"    # 日志名称